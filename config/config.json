{
  "testConfig": {
    "baseUrl": "http://localhost:5181",
    "seedCustomers": 25,
    "dataMode": "sequential",
    "thinkTime": { "min": 1, "max": 3 },
    "scenarios": {
      "naiveSave": {
        "enabled": true,
        "endpoint": "/api/saves/naive",
        "description": "The unoptimized save path: redundant reads, fragmented commits, lock-order inversion"
      },
      "optimizedSave": {
        "enabled": true,
        "endpoint": "/api/saves/optimized",
        "description": "The optimized save path: one load, one commit, deadlock retry"
      },
      "readCustomer": {
        "enabled": false,
        "endpoint": "/api/saves/{customerRef}",
        "description": "Read path, used to compare eager loading between the two implementations"
      }
    }
  },

  "profiles": {
    "smoke": {
      "description": "Quick validation that every endpoint responds correctly",
      "thinkTime": { "min": 1, "max": 2 },
      "scenarios": {
        "naiveSave": { "executor": "constant-vus", "vus": 1, "duration": "30s" },
        "optimizedSave": { "executor": "constant-vus", "vus": 1, "duration": "30s" },
        "readCustomer": { "executor": "constant-vus", "vus": 1, "duration": "30s" }
      },
      "thresholds": {
        "checks": ["rate>0.95"],
        "errors": ["rate<0.10"],
        "http_req_duration": ["p(95)<3000"]
      }
    },

    "load": {
      "description": "Expected production load on both implementations, side by side",
      "thinkTime": { "min": 0.5, "max": 1 },
      "scenarios": {
        "naiveSave": { "executor": "constant-vus", "vus": 10, "duration": "2m" },
        "optimizedSave": { "executor": "constant-vus", "vus": 10, "duration": "2m" },
        "readCustomer": { "executor": "constant-vus", "vus": 5, "duration": "2m" }
      },
      "thresholds": {
        "errors": ["rate<0.05"],
        "optimized_save_duration": ["p(95)<500", "p(99)<1500"],
        "optimized_save_db_queries": ["avg<6"],
        "successful_optimized_saves": ["count>0"]
      }
    },

    "stress": {
      "description": "Ramp until the naive path breaks down; the optimized path should hold",
      "thinkTime": { "min": 0.2, "max": 0.5 },
      "scenarios": {
        "naiveSave": {
          "executor": "ramping-vus",
          "startVUs": 5,
          "stages": [
            { "duration": "1m", "target": 20 },
            { "duration": "2m", "target": 40 },
            { "duration": "1m", "target": 0 }
          ]
        },
        "optimizedSave": {
          "executor": "ramping-vus",
          "startVUs": 5,
          "stages": [
            { "duration": "1m", "target": 20 },
            { "duration": "2m", "target": 40 },
            { "duration": "1m", "target": 0 }
          ]
        },
        "readCustomer": { "executor": "constant-vus", "vus": 5, "duration": "4m" }
      },
      "thresholds": {
        "optimized_save_duration": ["p(95)<2000"],
        "successful_optimized_saves": ["count>0"]
      }
    },

    "soak": {
      "description": "Sustained moderate load, looking for drift and leaks",
      "thinkTime": { "min": 1, "max": 3 },
      "scenarios": {
        "naiveSave": { "executor": "constant-vus", "vus": 5, "duration": "20m" },
        "optimizedSave": { "executor": "constant-vus", "vus": 5, "duration": "20m" },
        "readCustomer": { "executor": "constant-vus", "vus": 3, "duration": "20m" }
      },
      "thresholds": {
        "errors": ["rate<0.05"],
        "optimized_save_duration": ["p(95)<800"]
      }
    },

    "contention": {
      "description": "All VUs on one row - reproduces the deadlock the naive path cannot survive",
      "thinkTime": { "min": 0, "max": 0.1 },
      "hotRows": 1,
      "scenarios": {
        "naiveSave": { "executor": "constant-vus", "vus": 16, "duration": "1m" },
        "optimizedSave": { "executor": "constant-vus", "vus": 16, "duration": "1m" }
      },
      "thresholds": {
        "optimized_save_duration": ["p(95)<2000"],
        "failed_optimized_saves": ["count<1"]
      }
    }
  }
}
